# Строка подключения к базе Supabase.
# Дашборд → Project Settings → Database → Connection string → URI (пулер, порт 6543).
# Содержит пароль базы. Никогда не коммитить: .env в .gitignore.
SUPABASE_DB_URL=postgresql://postgres.tnlmtyhuuqpjwuhzximh:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Ключ Pexels для подбора студийных снимков блюд.
# Бесплатный и выдаётся сразу: https://www.pexels.com/api/
# Лицензия разрешает коммерческое использование без атрибуции.
PEXELS_API_KEY=
